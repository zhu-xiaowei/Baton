{
  "name": "agentpeek",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "npm run test:bridge && npm run test:codex && npm run test:frontend && npm run test:server && npm run test:packaging",
    "test:bridge": "node --test test/bridge/*.test.mjs",
    "test:codex": "node --test test/codex/phase1/*.test.mjs test/codex/phase2/*.test.mjs test/codex/phase3/*.test.mjs",
    "test:codex:e2e": "node test/codex/phase2/e2e.mjs --run",
    "test:codex:stress": "node test/codex/phase2/parcel-stress.mjs --run",
    "test:frontend": "node --test test/frontend/*.test.mjs && node test/frontend/run.mjs",
    "test:server": "python3 -m pytest test/server",
    "test:packaging": "node --test test/packaging/*.test.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "dev:android": "tauri android dev",
    "build:android": "tauri android build --apk --target aarch64",
    "dev:ios": "tauri ios dev \"iPhone 17 Pro\"",
    "build:ios": "tauri ios build",
    "release:ios": "./scripts/release-ios.sh",
    "build:mac": "./scripts/release-mac.sh",
    "build:windows": "./scripts/release-windows.sh"
  },
  "dependencies": {
    "@tauri-apps/plugin-barcode-scanner": "^2.4.4",
    "@tauri-apps/plugin-opener": "^2.2.6",
    "anser": "^2.3.5",
    "diff": "^5.2.0",
    "diff2html": "^3.4.51",
    "highlight.js": "^11.9.0",
    "marked": "^12.0.1",
    "qrcode-generator": "^1.4.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.0",
    "jsdom": "^29.1.1",
    "vite": "^5.4.10"
  }
}
