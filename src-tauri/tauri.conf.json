{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AgentPeek",
  "version": "0.2.0",
  "identifier": "com.agentpeek.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "lsof -ti:5173 >/dev/null 2>&1 || npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "AgentPeek",
        "width": 390,
        "height": 844,
        "resizable": true,
        "backgroundColor": "#0d1117"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24
    },
    "iOS": {
      "developmentTeam": "BUA6W9H7T3"
    }
  }
}
