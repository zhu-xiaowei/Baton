# Copy this file to .env.local and fill in real values.
# .env.local is gitignored.

# App Store Connect API credentials (used by scripts/release-ios.sh).
# Get them from: https://appstoreconnect.apple.com/access/integrations/api
# Also place the .p8 key at ~/.appstoreconnect/private_keys/AuthKey_<KEY_ID>.p8
APPSTORE_KEY_ID=
APPSTORE_ISSUER_ID=

# Deployed environment values (read from CFN outputs after deploy).
# Used by Claude as the source of truth — not auto-loaded by any script.
BATON_API_URL=
BATON_API_KEY=
